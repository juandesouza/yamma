# Copy to mobile/.env for Expo Go on a physical device against production APIs.

EXPO_PUBLIC_API_URL=https://yamma-api.onrender.com

# Omit when EXPO_PUBLIC_API_URL is HTTPS — Lemon return uses the API origin.
# EXPO_PUBLIC_PAYMENT_RETURN_BASE_URL=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
