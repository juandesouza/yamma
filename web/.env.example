NEXT_PUBLIC_API_URL=http://localhost:3001
# Socket.IO uses HTTP(S) origin (not ws://). Must match the Yamma Nest API PORT (default 3001).
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: server-side OAuth callback uses this to reach the API (try 127.0.0.1 if localhost fails)
# INTERNAL_API_URL=http://127.0.0.1:3001

# Same values as backend. Client secret is server-only (signs OAuth state for /api/auth/google).
# Google Cloud → APIs & Services → Credentials → your OAuth 2.0 Web client → Authorized redirect URIs.
# Add each origin you use, exactly (scheme + host + path, no trailing slash after .../callback):
#   http://localhost:3005/api/auth/google/callback
#   https://yamma-web.vercel.app/api/auth/google/callback
#   https://yamma-api.onrender.com/auth/google/expo-redirect   (Yamma mobile / Expo Go)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Force redirect_uri + token exchange origin (must match an Authorized redirect URI above).
# Production (Vercel): set to your live site origin, e.g. https://yamma-web.vercel.app
# Local: use if you open the site as http://127.0.0.1:3005 or http://[::1]:3005 instead of localhost.
# Production (Vercel): set to your public site origin so OAuth redirect_uri matches Google Console.
# OAUTH_PUBLIC_ORIGIN=https://yamma-web.vercel.app
# OAUTH_PUBLIC_ORIGIN=http://localhost:3005

# Local testing only (`next dev`): must match backend DEV_FORCE_CONFIRM_PAYMENT_TOKEN if you set it there —
# used for automatic “fake Lemon paid” after checkout (see resolve-pending-lemon-dev).
# NEXT_PUBLIC_DEV_FORCE_CONFIRM_PAYMENT_TOKEN=
